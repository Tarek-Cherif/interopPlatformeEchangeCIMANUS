# Exemple sans secrets. Spring Boot ne charge pas .env automatiquement.
# À injecter par votre gestionnaire de service / IDE / CI.
ORACLE_DB_URL=jdbc:oracle:thin:@192.168.3.13:1521:dbcnr
ORACLE_DB_USERNAME=affnouv
ORACLE_DB_PASSWORD=
SCP_HOST=192.168.3.13
SCP_PORT=22
SCP_USERNAME=oracle
SCP_PASSWORD=
SCP_REMOTE_DIRECTORY=/oracle/traitement
SCP_KNOWN_HOSTS=/chemin/securise/known_hosts
SCP_TIMEOUT=30000
EPIC_OPERATION_DATE_FORMAT="dd/MM/yyyy HH:mm:ss"
EPIC_TIME_ZONE=Africa/Tunis
EPIC_ORACLE_TIMEOUT_SECONDS=300
EPIC_MAX_FILE_SIZE=20MB
EPIC_MAX_REQUEST_SIZE=21MB
SERVER_PORT=8080
